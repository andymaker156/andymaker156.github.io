#!/bin/sh
# Second layer: catch wrong-identity commits that skipped pre-commit
# (amend, rebase, cherry-pick, --no-verify) before they reach GitHub.

expected='61553355+andymaker156@users.noreply.github.com'
merge_bot='noreply@github.com'   # committer on merges made through the web UI
zero='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue
	if [ "$remote_sha" = "$zero" ]; then
		revs=$(git rev-list "$local_sha" --not --remotes=origin)
	else
		revs=$(git rev-list "$remote_sha..$local_sha")
	fi
	[ -n "$revs" ] || continue
	bad=$(echo "$revs" | git log --stdin --no-walk --format='%H %ae %ce' |
		while read -r sha ae ce; do
			[ "$ae" = "$expected" ] || { echo "$sha author=$ae"; continue; }
			[ "$ce" = "$expected" ] || [ "$ce" = "$merge_bot" ] ||
				echo "$sha committer=$ce"
		done)
	if [ -n "$bad" ]; then
		echo "pre-push: these commits carry the wrong identity:" >&2
		echo "$bad" | sed 's/^/  /' >&2
		status=1
	fi
done

if [ "$status" -ne 0 ]; then
	echo "" >&2
	echo "Rewrite them with <$expected> before pushing." >&2
fi
exit $status
